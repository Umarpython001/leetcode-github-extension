{
  "manifest_version": 3,

  "name": "leetcode-github-extension",

  "version": "1.0",

  "description": "An extension that automatically makes github commits for every leetcode problem that I solve",

  "action":{

    "default_icon": "default_icon.png",

    "default_popup": "popup/popup.html"

  },

  "background":{
    "service_worker": "background/background_script.js"
  },

  "content_scripts":[
    {
    
      "js": ["scripts/get_solved_question.js"],

        "matches": [
            "https://leetcode.com/problems/*"
        ]

    }

  ]
}